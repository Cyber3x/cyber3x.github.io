---
import { SITE_NAV } from "../consts";
import { cn } from "../lib/utils";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname;

const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header class="mb-8 flex items-center justify-between" transition:name="header">
  <nav class="flex items-center gap-4">
    {
      SITE_NAV.map(({ label, href }) => (
        <a
          href={href}
          aria-current={isActive(href) ? "page" : undefined}
          class={cn(
            "font-medium text-muted hover:text-zinc-900 hover:underline dark:hover:text-zinc-100",
            isActive(href) && "text-zinc-900 dark:text-night-text",
          )}
        >
          {label}
        </a>
      ))
    }
  </nav>
  <ThemeToggle />
</header>
