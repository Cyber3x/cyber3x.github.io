---
import { cn } from "@/lib/utils";
import { type CollectionEntry, render } from "astro:content";

interface Props {
  machine: CollectionEntry<"computers">;
}

const { machine } = Astro.props;
const {
  name,
  title,
  role,
  status,
  since,
  until,
  image,
  imageAlt,
  specs,
  links,
} = machine.data;
const { Content } = await render(machine);

// Applied per element rather than on the flex container: a decoration set on the
// container is propagated into each flex child at the container's font metrics, which
// draws the line at a different height on the mono codename and the smaller title.
const strike = status === "retired" && "line-through";

const years =
  since && until
    ? `${since} to ${until}`
    : since
      ? `since ${since}`
      : undefined;
---

<hr class="my-16 border-zinc-200 dark:border-night-border" />

<section id={name} class="scroll-mt-8">
  <header class="mb-4">
    <h2 class="flex flex-wrap items-baseline gap-x-3 text-2xl font-medium">
      <a href={`#${name}`} class={cn("font-mono hover:underline", strike)}>
        {name}
      </a>
      <span class={cn("text-base font-normal text-muted", strike)}>{title}</span
      >
    </h2>
    <p class="mt-1 text-muted">
      {role}
      {years && <span>, {years}</span>}
      {
        status === "retired" && (
          <span class="ml-2 rounded border border-zinc-200 px-1 text-xs uppercase dark:border-night-border">
            retired
          </span>
        )
      }
      {
        !machine.data.public && (
          <span class="ml-2 rounded border border-zinc-200 px-1 text-xs dark:border-night-border">
            draft
          </span>
        )
      }
    </p>
  </header>

  {
    image && (
      <img
        src={image}
        alt={imageAlt ?? title}
        loading="lazy"
        class="mb-6 border border-zinc-200 dark:border-night-border"
      />
    )
  }

  {
    specs.length > 0 && (
      <table class="mb-6 w-full border-collapse text-sm">
        <tbody>
          {specs.map(({ label, value }) => (
            <tr>
              <th
                scope="row"
                class="w-1/3 border border-zinc-300 px-3 py-1.5 text-left font-medium text-muted dark:border-night-border"
              >
                {label}
              </th>
              <td class="border border-zinc-300 px-3 py-1.5 dark:border-night-border">
                {value}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }

  <article>
    <Content />
  </article>

  {
    links.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {links.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="text-muted underline hover:text-zinc-900 dark:hover:text-night-text"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
