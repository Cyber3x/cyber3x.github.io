---
import { getCollection } from "astro:content";
import Machine from "../../components/Machine.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Layout from "../../layouts/Layout.astro";
import { cn } from "../../lib/utils";

const description = "The machines I work on, what runs on them, and why.";

const machines = (
  await getCollection(
    "computers",
    ({ data }) => data.public || import.meta.env.DEV,
  )
).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    a.data.status.localeCompare(b.data.status) ||
    a.data.name.localeCompare(b.data.name),
);

const groups = [
  { heading: "(Com)Putters", status: "active" },
  { heading: "Retired", status: "retired" },
]
  .map((group) => ({
    ...group,
    machines: machines.filter((m) => m.data.status === group.status),
  }))
  .filter((group) => group.machines.length > 0);
---

<Layout title="Computer" description={description}>
  <main>
    <SectionHeading title="Computer" description={description} />

    {machines.length === 0 && <p class="text-muted">No machines listed yet.</p>}

    <nav
      aria-label="Machines"
      class="grid gap-y-0.5 sm:grid-cols-[max-content_1fr] sm:items-baseline sm:gap-x-6"
    >
      {
        groups.map(({ heading, status, machines }, i) => (
          <div class="contents">
            <h2
              class={cn(
                "col-span-full mb-1 text-sm font-medium text-muted",
                i > 0 && "mt-4",
              )}
            >
              {heading}
            </h2>
            <ul class="contents">
              {machines.map(({ data }) => (
                <li class="flex flex-col sm:contents">
                  <a
                    href={`#${data.name}`}
                    class={cn(
                      "font-mono hover:underline",
                      status === "retired" && "line-through",
                    )}
                  >
                    {data.name}
                  </a>
                  <span
                    class={cn(
                      "text-sm text-muted",
                      status === "retired" && "line-through",
                    )}
                  >
                    {data.title}, {data.role}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    {machines.map((machine) => <Machine machine={machine} />)}
  </main>
</Layout>
