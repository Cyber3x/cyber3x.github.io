---
import { getCollection } from "astro:content";
import PostList from "../../components/PostList.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Layout from "../../layouts/Layout.astro";

const description = "Longer pieces, dated and mostly left as written.";

const posts = (
  await getCollection("posts", ({ data }) => data.public || import.meta.env.DEV)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Posts" description={description}>
  <main>
    <SectionHeading title="Posts" description={description} />
    <PostList posts={posts} />
  </main>
</Layout>
