---
import { getCollection } from "astro:content";
import SectionHeading from "../../components/SectionHeading.astro";
import SoftwareSection from "../../components/SoftwareSection.astro";
import Layout from "../../layouts/Layout.astro";

const description = "The software I use, grouped so it is easy to skim.";

const sections = (await getCollection("software")).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
---

<Layout title="Software" description={description}>
  <main>
    <SectionHeading title="Software" description={description} />

    {sections.length === 0 && <p class="text-muted">Nothing listed yet.</p>}

    <nav aria-label="Sections">
      <h2 class="mb-1 text-sm font-medium text-muted">Sections</h2>
      <ul class="space-y-0.5 font-mono">
        {
          sections.map(({ id, data }) => (
            <li>
              <a href={`#${id}`} class="hover:underline">
                {data.title}
              </a>
              {data.items.length > 0 && (
                <span class="text-sm text-muted"> ({data.items.length})</span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    {sections.map((entry) => <SoftwareSection entry={entry} />)}
  </main>
</Layout>
